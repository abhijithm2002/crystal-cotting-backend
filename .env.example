NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/crystalcoat
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
WEBSITE_ORIGIN=http://localhost:5174
ADMIN_ORIGIN=http://localhost:5173
# Render: mount a persistent disk at /var/data, then set UPLOADS_DIR=/var/data/uploads.
# Without this setting, local uploads use src/uploads.
# UPLOADS_DIR=/var/data/uploads
# Configure SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS and MAIL_FROM for reset emails.
